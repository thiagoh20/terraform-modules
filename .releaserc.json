{
  "branches": ["main"],
  "preset": "conventionalcommits",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "feat",
            "section": "🚀 Features",
            "release": "minor"
          },
          {
            "type": "fix",
            "section": "🐛 Bug Fixes",
            "release": "patch"
          },
          {
            "type": "perf",
            "section": "⚡ Performance Improvements",
            "release": "patch"
          },
          {
            "type": "docs",
            "section": "📚 Documentation",
            "release": false
          },
          {
            "type": "style",
            "section": "💅 Styles",
            "release": false
          },
          {
            "type": "refactor",
            "section": "♻️ Code Refactoring",
            "release": "patch"
          },
          {
            "type": "test",
            "section": "✅ Tests",
            "release": false
          },
          {
            "type": "build",
            "section": "👷 Build System",
            "release": "patch"
          },
          {
            "type": "ci",
            "section": "🔧 Continuous Integration",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "breaking": true,
            "section": "💥 BREAKING CHANGES",
            "release": "major"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "🚀 Features"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "perf",
              "section": "⚡ Performance Improvements"
            },
            {
              "type": "refactor",
              "section": "♻️ Code Refactoring"
            },
            {
              "type": "build",
              "section": "👷 Build System"
            },
            {
              "type": "docs",
              "section": "📚 Documentation",
              "hidden": false
            }
          ]
        },
        "writerOpts": {
          "commitsSort": ["subject", "scope"]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n\nThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/),\nand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\n\n## Breaking Changes Notice\n\n⚠️ **IMPORTANT**: Breaking changes are marked with 💥 and require attention during upgrades.\nPlease read the migration guide for each breaking change before updating."
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "CHANGELOG.md",
            "label": "Changelog"
          }
        ],
        "addReleases": "bottom"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "package-lock.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ],
  "tagFormat": "v${version}"
}
